{
  "name": "rezzident-ecosystem",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=rezzident-fe",
    "dev:mobile": "turbo run dev --filter=rezzident-mb",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=rezzident-fe",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run check",
    "format": "turbo run format",
    "clean": "turbo run clean && rm -rf node_modules",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "test:be": "cd apps/rezzident_BE && python -m pytest tests/ -v",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "turbo": "^2.3.3",
    "typescript": "~6.0.3"
  }
}
