# ── Environment ──
PYTHON_ENV=development

# ── Database ──
DB_TYPE=postgresql
DB_NAME=rezzident_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_POOL_SIZE =10
DB_MAX_OVERFLOW =20
DB_POOL_RECYCLE =300
DB_POOL_PRE_PING =True
DB_URL=postgresql://postgres:your_secure_password_here@localhost:5432/rezzident_db

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Security ──
# IMPORTANT: Generate a real 64-byte hex key: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_64_byte_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRY=7

# ── Application ──
APP_URL=http://localhost:7001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Paystack ──
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── Termii (SMS OTP) ──
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Rezzident

# ── Dojah (NIN Verification) ──
DOJAH_APP_ID=your_dojah_app_id
DOJAH_SECRET_KEY=your_dojah_secret_key
DOJAH_API_KEY=your_dojah_api_key

# ── MinIO (Object Storage) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rezzident
MINIO_USE_SSL=false

# ── Cloudinary (Image CDN) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email ──
MAIL_USERNAME=noreply@rezzident.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@rezzident.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com

# ── Super Admin ──
SUPER_ADMIN_SETUP_KEY=change_this_to_a_secure_random_key
